<!-- Plugin: api --> <!-- the two site fonts are fetched right away (otherwise they arrive after the first paint, the text rewraps from the fallback font = layout shift) -->
<link rel="preload" href="https://framerusercontent.com/assets/eegZ1ZoVjnHyJtxDMTEhJ2Bhf4.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="https://framerusercontent.com/assets/borEE9veyD0zs6Cs5ThKJI0LcKU.woff2" as="font" type="font/woff2" crossorigin>
<!-- text sizes + phone flag, in the HTML from the start (otherwise texts change size once the code has loaded = layout shift); the code skips adding them when they exist -->
<style id="casa-type-styles">:root{--casa-p1-size:calc(var(--casa-page-w, 100vw) * 0.020000);--casa-p1-lh:1.2em;--casa-p1-ls:-0.2px}@media (max-width: 809.98px){:root{--casa-p1-size:24px}}</style>
<style id="casa-phone">@media (max-width: 809.98px){:root{--casa-phone:1}}</style>
<style id="casa-selection">::selection{background-color:#BC6F45;color:#FFF0CA}::-moz-selection{background-color:#BC6F45;color:#FFF0CA}</style><style id="casa-tap-highlight">*{-webkit-tap-highlight-color:transparent}</style><style id="casa-a11y">
/* text that is only for screen readers and search engines (e.g. the homepage H1) */
[data-framer-name="SEO Heading"]{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;clip-path:inset(50%)!important;white-space:nowrap!important;border:0!important}
/* keyboard focus ring (only for keyboard users, never for mouse / touch) */
:focus-visible{outline:2px solid #FFF0CA!important;outline-offset:2px!important;box-shadow:0 0 0 4px #0E1201!important;border-radius:2px}
:focus:not(:focus-visible){outline:none}
/* "reduce motion" system setting: no CSS transitions / animations, tickers stand still */
@media (prefers-reduced-motion: reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}ul[data-casa-gap]{transform:none!important}}
</style><style id="casa-sticky-button">/* "Check Availability" on the apartment pages: on phones 12px above the bottom of the screen (Desktop + Tablet: 48px at 1600, fluid above like the other spacings) */@media (max-width: 809.98px){[data-framer-name="Sticky Button"]{bottom:12px!important}}@media (min-width: 810px){[data-framer-name="Sticky Button"]{bottom:max(48px, calc(var(--casa-page-w, 100vw) * 0.030000))!important}}</style>
<style id="casa-pulse">
/* "Check Availability": a ring (box shadow, so its corners stay close to the button's 2px) in the button's own colour grows to 15px and fades out, every 2.55s
   (starts 1px inside the edge, so the button itself never looks thicker; beige on the dark sections, olive on the light ones, where the button switches to "Large Dark") */
@keyframes casa-pulse{0%{box-shadow:0 0 0 -1px var(--casa-pulse)}100%{box-shadow:0 0 0 15px var(--casa-pulse-0)}}
[data-framer-name="Sticky Button"] :is([data-framer-name="Large"],[data-framer-name="Large Hover"]){--casa-pulse:rgba(255,240,202,.85);--casa-pulse-0:rgba(255,240,202,0)}
[data-framer-name="Sticky Button"] :is([data-framer-name="Large Dark"],[data-framer-name="Large Dark Hover"]){--casa-pulse:rgba(14,18,1,.85);--casa-pulse-0:rgba(14,18,1,0)}
[data-framer-name="Sticky Button"] :is([data-framer-name="Large"],[data-framer-name="Large Hover"],[data-framer-name="Large Dark"],[data-framer-name="Large Dark Hover"]){animation:casa-pulse 2.55s cubic-bezier(0.66,0,0,1) infinite}
@media (prefers-reduced-motion: reduce){[data-framer-name="Sticky Button"] [data-framer-name]{animation:none!important;box-shadow:none!important}}
</style>
<style id="casa-scroll-hint">
/* apartment page: the arrow next to "Scroll to Explore" drifts down and back up in a calm loop
   (CSS translate only, so the arrow's own rotation stays untouched) */
@keyframes casa-scroll-hint{0%,100%{translate:0 -1.5px}50%{translate:0 3px}}
[data-framer-name="Sticky Header Text"] [data-framer-name="Menu Title"] > [data-framer-name="Number"] > *{animation:casa-scroll-hint 2.4s cubic-bezier(0.45,0,0.55,1) infinite}
@media (prefers-reduced-motion: reduce){[data-framer-name="Sticky Header Text"] [data-framer-name="Menu Title"] > [data-framer-name="Number"] > *{animation:none}}
</style>

<!-- casa-awwwards-a11y -->
<meta property="og:site_name" content="Casa Momo">
<meta property="og:locale" content="en_GB">
<!-- the business for search engines, in the HTML from the start (the site script adds the apartment on apartment pages) -->
<script type="application/ld+json" id="casa-structured-data">{"@context":"https://schema.org","@graph":[{"@type":"LodgingBusiness","@id":"https://www.casamomo.at/#casamomo","name":"Casa Momo","description":"Personally designed apartments for short and longer stays in the historic centre of Graz.","url":"https://www.casamomo.at/","telephone":"+43 664 1999605","email":"office@casamomo.at","address":{"@type":"PostalAddress","addressLocality":"Graz","addressRegion":"Styria","addressCountry":"AT"},"sameAs":["https://www.instagram.com/casamomo.at/"]}]}</script>
<style id="casa-a11y-2">
/* "Skip to content": hidden until it gets the keyboard focus */
.casa-skip{position:fixed;left:12px;top:12px;z-index:2147483647;padding:12px 16px;border-radius:2px;background:#FFF0CA;color:#0E1201;font:16px/1.2 "Lay Grotesk Regular",sans-serif;text-decoration:none;transform:translateY(-200%)}
.casa-skip:focus{transform:none}
/* whatever holds the focused element is fully visible (fade-ins and the navbar fade never hide the focus) */
*:has(:focus-visible){opacity:1!important}
/* larger tap areas for small links (same look) */
[data-framer-name="Imprint/Legal"] a{position:relative}
[data-framer-name="Imprint/Legal"] a::after{content:"";position:absolute;inset:-10px -6px}
a[data-framer-name="Logo"]::after{content:"";position:absolute;inset:-12px -8px}
/* links in the legal texts (Imprint, Terms, Privacy) are underlined */
[data-framer-name="Legal Content"] a{text-decoration:underline!important;text-underline-offset:0.2em;text-decoration-thickness:1px}
</style>
<!-- without JavaScript, texts that normally fade in are simply shown -->
<noscript><style>[data-framer-appear-id],[style*="opacity:0.001"]{opacity:1!important;transform:none!important;filter:none!important}</style></noscript>
